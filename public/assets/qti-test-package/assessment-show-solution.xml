<?xml version="1.0" encoding="utf-8"?>
<qti-assessment-test
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0_v1p0.xsd"
        identifier="ShowSolutionTest"
        title="Show Solution Test"
        xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
>
    <qti-test-part identifier="test-part-1" navigation-mode="nonlinear" submission-mode="individual">
        <!-- show-solution opts the item into revealing candidate correction and the
             correct response; max-attempts=2 means the correct answer is revealed
             on a correct attempt or once both attempts are spent. -->
        <qti-assessment-section identifier="section-show-solution" title="Show Solution" visible="true">
            <qti-item-session-control show-solution="true" max-attempts="2"/>
            <qti-assessment-item-ref identifier="ITM-choice-solution" href="items/choice.xml"/>
        </qti-assessment-section>
    </qti-test-part>
</qti-assessment-test>
